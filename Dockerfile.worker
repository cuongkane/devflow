FROM ghcr.io/dagucloud/dagu:latest AS dagu

# rtk filters and summarises command output before it reaches the agent's
# context. Every byte a command prints inside a phase is re-sent to the model on
# every subsequent request of that phase, so the cost of a chatty command is
# quadratic, not linear -- one 148 KB grep in the review phase of issue #116 was
# paid for roughly thirty times over. On the host rtk is a brew install driven by
# a Claude Code hook; neither reaches a codex process inside this container, so
# it is installed here and the phase prompts name it directly.
#
# Built from source rather than taken from the release page. The project does
# publish binaries, but the only aarch64 Linux one is linked against glibc 2.39
# and this image is bookworm, which is 2.36 -- it installs cleanly and then fails
# to start. Building in a `rust:*-bookworm` stage gets a binary linked against
# the glibc that is actually here, on both architectures, and costs nothing after
# the first build because the layer caches.
FROM rust:1-bookworm AS rtk
ARG RTK_VERSION=0.45.0
RUN curl -fsSL "https://github.com/rtk-ai/rtk/archive/refs/tags/v${RTK_VERSION}.tar.gz" \
      | tar -xz -C /tmp \
    && cargo install --path "/tmp/rtk-${RTK_VERSION}" --root /usr/local --locked \
    && /usr/local/bin/rtk --version

FROM node:22-bookworm-slim

ARG CODEX_VERSION=0.147.0
ARG CLAUDE_CODE_VERSION=2.1.232
ARG OPENCODE_VERSION=1.18.18

# The implementation pipeline drives OpenSpec directly from shell -- it proposes,
# validates and archives changes -- so the CLI has to exist in this image. On the
# host it is a Volta-managed global, which the container cannot see: ~/.volta is
# not mounted, and mounting it would drag in a macOS toolchain anyway.
ARG OPENSPEC_VERSION=1.4.1

# SweatCharge runs its Django suite through `docker compose run` against the
# mounted host socket, so the worker needs Compose v2. Debian's `docker.io` is
# CLI 20.10 with no plugin directory at all, so take the CLI and the plugin from
# Docker's own repository instead.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gh \
        git \
        gnupg \
        jq \
        make \
        openssh-client \
        tini \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg \
        -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] \
https://download.docker.com/linux/debian bookworm stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        docker-ce-cli \
        docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global \
        "@openai/codex@${CODEX_VERSION}" \
        "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
        "opencode-ai@${OPENCODE_VERSION}" \
        "@fission-ai/openspec@${OPENSPEC_VERSION}"

# sweatcharge_fe pins yarn 4.9.2 through `packageManager`, which Corepack
# enforces; the node image ships yarn 1.22 as a plain global, so every `yarn`
# call aborts before it runs. Replace those shims and bake the pinned release
# into the image so the first run does not have to fetch it.
ARG YARN_VERSION=4.9.2
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN rm -f /usr/local/bin/yarn /usr/local/bin/yarnpkg \
    && corepack enable \
    && corepack install --global "yarn@${YARN_VERSION}"

# The two copied-in binaries last, below the corepack layer: bumping RTK_VERSION
# should not re-download yarn.
COPY --from=dagu /usr/local/bin/dagu /usr/local/bin/dagu
COPY --from=rtk /usr/local/bin/rtk /usr/local/bin/rtk
COPY worker-entrypoint.sh /usr/local/bin/worker-entrypoint
RUN chmod +x /usr/local/bin/worker-entrypoint

ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/usr/local/bin/worker-entrypoint"]

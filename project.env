# Shared defaults for all three task DAGs. Change this file to target another
# repository; individual runs can still override the matching DAG parameters.
#
# The skills below are named for their *workflow* only. The engineering practices
# and testing standards live in prompts/standards/ and are pasted into the prompts
# that need them, so no phase reads a skill to find out how well to work.
# IMPLEMENT_SKILL is now only reported in the run view: every implementation phase
# prompt is self-contained.
PROJECT_REPO=cuongkane/sweatcharge
PROJECT_WORKSPACE=/Users/lexuancuong/CUONG/SWC
CLARIFY_SKILL=clarify-sweatcharge-issue
IMPLEMENT_SKILL=implement-sweatcharge-feature
REVIEW_SKILL=respond-sweatcharge-review

# The OpenSpec CLI ships PostHog telemetry with a 1000 ms fetch timeout, and every
# flush that misses that window prints a twelve-line stack trace to stderr. Three
# steps in the implementation DAG call `openspec`, and a fourth reads their output
# to decide whether the run is healthy -- so the noise is not merely ugly: it
# buried a real `openspec validate --specs --strict` failure under six copies of
# `PostHogFetchNetworkError` in run 156. `0` is the CLI's own documented opt-out.
OPENSPEC_TELEMETRY=0

# Host-specific paths. Copy to .env and edit for this machine; .env is
# gitignored so real paths never get committed.
#
# Docker Compose loads .env automatically (compose.yaml) and the Makefile
# exports the same DAGU_ROOT for host-side `dagu start`/`dagu validate` runs.
# All three must be absolute paths, identical on the host and inside the
# worker container -- the DAG definitions under dags/ refer to them directly.

# This repository's own absolute path.
DAGU_ROOT=/absolute/path/to/DAGU

# The target repository the three DAGs operate on (also set in project.env).
PROJECT_WORKSPACE=/absolute/path/to/target/repo

# Sibling directory the implementer creates git worktrees under, named
# "<PROJECT_WORKSPACE>-worktrees" by convention.
PROJECT_WORKTREES_DIR=/absolute/path/to/target/repo-worktrees

# Dotfiles checkout the configured coding-agent skills symlink into.
DOTFILES_DIR=/absolute/path/to/dotfiles
